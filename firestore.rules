rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posted plant logs can be created, updated (e.g. restored running), and read live across all devices,
    // but NO ONE can delete posted information.
    match /downtime_entries/{entryId} {
      allow read: if true;
      allow create: if !('del' in request.resource.data) || request.resource.data.del != 1;
      allow update: if !('del' in request.resource.data) || request.resource.data.del != 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
