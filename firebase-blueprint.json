{
  "entities": {
    "downtime_log": {
      "title": "Downtime Log Entry",
      "description": "Log of machine/equipment downtime incident with resolution and digital signatures",
      "type": "object",
      "properties": {
        "equipmentId": { "type": "string", "maxLength": 100 },
        "equipmentName": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "severity": { "type": "string", "maxLength": 30 },
        "startTime": { "type": "string", "maxLength": 50 },
        "endTime": { "type": "string", "maxLength": 50 },
        "durationMinutes": { "type": "number" },
        "faultDescription": { "type": "string", "maxLength": 2000 },
        "rootCause": { "type": "string", "maxLength": 2000 },
        "actionTaken": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "maxLength": 30 },
        "technicianName": { "type": "string", "maxLength": 100 },
        "technicianBadge": { "type": "string", "maxLength": 50 },
        "supervisorName": { "type": "string", "maxLength": 100 },
        "technicianSignature": { "type": "string", "maxLength": 200000 },
        "technicianSignedAt": { "type": "string", "maxLength": 50 },
        "supervisorSignature": { "type": "string", "maxLength": 200000 },
        "supervisorSignedAt": { "type": "string", "maxLength": 50 },
        "digitalVerificationCode": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "equipmentId",
        "equipmentName",
        "date",
        "shift",
        "category",
        "severity",
        "startTime",
        "status"
      ]
    },
    "daily_summary": {
      "title": "Daily Shift Summary",
      "description": "Daily operational summary report with shift metrics and supervisor sign-off",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 50 },
        "totalIncidents": { "type": "number" },
        "totalDowntimeMinutes": { "type": "number" },
        "availabilityPercent": { "type": "number" },
        "operatingHours": { "type": "number" },
        "dailyNotes": { "type": "string", "maxLength": 3000 },
        "shiftSupervisor": { "type": "string", "maxLength": 100 },
        "supervisorSignature": { "type": "string", "maxLength": 200000 },
        "isClosed": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["date", "shift", "totalIncidents", "totalDowntimeMinutes"]
    },
    "plant_user": {
      "title": "Plant Operator Account",
      "description": "Plant staff and operator credentials provisioned exclusively by Administrator",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "department": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 30 }
      },
      "required": ["email", "displayName", "role"]
    },
    "dispatch_entry": {
      "title": "Shift Dispatch & Verification Record",
      "description": "Three-stage production dispatch movement form with unit weights, WH confirmation, and HOD final sign-off",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "machine": { "type": "string", "maxLength": 100 },
        "product": { "type": "string", "maxLength": 200 },
        "operatorName": { "type": "string", "maxLength": 120 },
        "assistantName": { "type": "string", "maxLength": 120 },
        "casualAssistantName": { "type": "string", "maxLength": 120 },
        "trolleys": { "type": "number" },
        "shiftQty": { "type": "number" },
        "unitWeightKg": { "type": "number" },
        "totalWeightKg": { "type": "number" },
        "whConfirmedQty": { "type": "number" },
        "hodConfirmedQty": { "type": "number" },
        "status": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["date", "shift", "machine", "product", "shiftQty", "status"]
    },
    "sop_production_log": {
      "title": "SOP Floor Production Job Card",
      "description": "Shift production output, linked scrap, wastage, and downtime log from WhatsApp or floor form",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "machine": { "type": "string", "maxLength": 100 },
        "product": { "type": "string", "maxLength": 200 },
        "operator": { "type": "string", "maxLength": 120 },
        "assistant": { "type": "string", "maxLength": 120 },
        "actualQty": { "type": "number" },
        "scrapKg": { "type": "number" },
        "wastageKg": { "type": "number" },
        "downtimeMins": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["date", "shift", "machine", "product"]
    },
    "sop_qc_check": {
      "title": "SOP Quality Control Check",
      "description": "Hourly or per-shift QC inspection record and pass/fail audit",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "machine": { "type": "string", "maxLength": 100 },
        "product": { "type": "string", "maxLength": 200 },
        "inspector": { "type": "string", "maxLength": 120 },
        "result": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "number" }
      },
      "required": ["date", "machine", "product", "result"]
    },
    "sop_scrap_record": {
      "title": "SOP Closed-Loop Scrap Pipeline",
      "description": "Multi-stage scrap handover from Operator Assistant to Recycling Team to Mixers",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "machine": { "type": "string", "maxLength": 100 },
        "material": { "type": "string", "maxLength": 200 },
        "weightKg": { "type": "number" },
        "usableRegrindKg": { "type": "number" },
        "allProcessedUsable": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["date", "machine", "weightKg", "status"]
    },
    "sop_mixing_report": {
      "title": "SOP Mixing & WH Reserve Stock Report",
      "description": "Mixer consumption of WH virgin material & recycled scrap, sweeping generation, batches, and HOD confirmation",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "mixerName": { "type": "string", "maxLength": 120 },
        "materialType": { "type": "string", "maxLength": 200 },
        "whReservedMaterialKg": { "type": "number" },
        "scrapReceivedFromRecyclingKg": { "type": "number" },
        "whMaterialUsedKg": { "type": "number" },
        "scrapUsedInMixingKg": { "type": "number" },
        "sweepingMaterialKg": { "type": "number" },
        "batchesMixed": { "type": "number" },
        "pendingMix": { "type": "number" },
        "endOfMixingStockKg": { "type": "number" },
        "status": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["date", "mixerName", "materialType", "status"]
    },
    "sop_shift_handover": {
      "title": "SOP Shift Handover Log",
      "description": "End-of-shift floor operational handover sign-off",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "outgoingShift": { "type": "string", "maxLength": 20 },
        "outgoingSupervisor": { "type": "string", "maxLength": 120 },
        "incomingSupervisor": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "number" }
      },
      "required": ["date", "outgoingShift", "outgoingSupervisor"]
    },
    "production_plan_item": {
      "title": "Monthly Production Plan Item",
      "description": "Uploaded monthly product planning targets tracked against month dispatch quantities with auto-red closure",
      "type": "object",
      "properties": {
        "month": { "type": "string", "maxLength": 10 },
        "product": { "type": "string", "maxLength": 200 },
        "machine": { "type": "string", "maxLength": 100 },
        "plannedQty": { "type": "number" },
        "plannedKg": { "type": "number" },
        "jobCardNo": { "type": "string", "maxLength": 80 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "upd": { "type": "number" }
      },
      "required": ["month", "product", "plannedQty"]
    },
    "diesel_tank_config": {
      "title": "Factory Diesel Bowser Tank Ledger",
      "description": "Live diesel bowser fuel level and totalizer meter state",
      "type": "object",
      "properties": {
        "tankName": { "type": "string", "maxLength": 120 },
        "capacityLitres": { "type": "number" },
        "currentLevelLitres": { "type": "number" },
        "currentMeterReading": { "type": "number" },
        "totalReceivedLitres": { "type": "number" },
        "totalIssuedLitres": { "type": "number" },
        "lastUpdatedAt": { "type": "string", "maxLength": 50 },
        "upd": { "type": "number" }
      },
      "required": ["tankName", "currentLevelLitres", "currentMeterReading"]
    },
    "diesel_fuel_request": {
      "title": "Diesel Fuel Issue Request",
      "description": "3-stage Forklift Driver -> Production HOD Approval (1-time PDF unlock) -> Bowser Meter Reading dispense record with digital signatures",
      "type": "object",
      "properties": {
        "requestNo": { "type": "string", "maxLength": 40 },
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "vehicleOrForklift": { "type": "string", "maxLength": 120 },
        "driverName": { "type": "string", "maxLength": 120 },
        "requestedLitres": { "type": "number" },
        "status": { "type": "string", "maxLength": 40 },
        "pdfGeneratedOnce": { "type": "boolean" },
        "firstMeterReading": { "type": "number" },
        "secondMeterReading": { "type": "number" },
        "actualLitresTaken": { "type": "number" },
        "upd": { "type": "number" }
      },
      "required": ["requestNo", "date", "vehicleOrForklift", "driverName", "requestedLitres", "status"]
    },
    "diesel_grn_record": {
      "title": "Diesel Bowser GRN Record",
      "description": "Goods Received Note adding bulk supplier diesel into bowser tank via dual meter readings & signatures",
      "type": "object",
      "properties": {
        "grnNo": { "type": "string", "maxLength": 40 },
        "date": { "type": "string", "maxLength": 20 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "receiverName": { "type": "string", "maxLength": 120 },
        "firstMeterReading": { "type": "number" },
        "secondMeterReading": { "type": "number" },
        "litresAdded": { "type": "number" },
        "tankLevelAfter": { "type": "number" },
        "upd": { "type": "number" }
      },
      "required": ["grnNo", "date", "supplierName", "firstMeterReading", "secondMeterReading", "litresAdded"]
    },
    "power_cut_log": {
      "title": "Plant Power Cut Log",
      "description": "Records ZESA/mains power cut time out, time back, duration in minutes/hours, and generator activation",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "timeOut": { "type": "string", "maxLength": 40 },
        "timeBack": { "type": "string", "maxLength": 40 },
        "durationMinutes": { "type": "number" },
        "affectedArea": { "type": "string", "maxLength": 150 },
        "generatorUsed": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 30 },
        "reason": { "type": "string", "maxLength": 500 },
        "loggedBy": { "type": "string", "maxLength": 120 },
        "upd": { "type": "number" }
      },
      "required": ["date", "shift", "timeOut", "status"]
    },
    "generator_log": {
      "title": "Factory Generator Start Up & Stop Log",
      "description": "Records generator start/stop times, fuel levels in Litres (start/stop/consumed), and linkage to Generator machine",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 40 },
        "startFuelLitres": { "type": "number" },
        "stopTime": { "type": "string", "maxLength": 40 },
        "stopFuelLitres": { "type": "number" },
        "fuelUsedLitres": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "linkedPowerCutId": { "type": "string", "maxLength": 120 },
        "linkedDowntimeEntryId": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "maxLength": 30 },
        "operatorName": { "type": "string", "maxLength": 120 },
        "upd": { "type": "number" }
      },
      "required": ["date", "shift", "startTime", "startFuelLitres", "status"]
    }
  },
  "firestore": {
    "/downtime_logs/{logId}": {
      "schema": "downtime_log",
      "description": "Individual machine and line downtime incident reports"
    },
    "/daily_summaries/{summaryId}": {
      "schema": "daily_summary",
      "description": "Daily shift downtime summaries and supervisor handovers"
    },
    "/plant_users/{userId}": {
      "schema": "plant_user",
      "description": "Registered operator accounts managed exclusively by Plant Administration"
    },
    "/dispatch_entries/{id}": {
      "schema": "dispatch_entry",
      "description": "3-stage Shift Dispatch entries with weights and linked casual/WH info"
    },
    "/historical_dispatch_uploads/{id}": {
      "schema": "dispatch_entry",
      "description": "Uploaded previous months background dispatch records for production continuation"
    },
    "/monthly_production_plans/{id}": {
      "schema": "production_plan_item",
      "description": "Monthly production planning job cards tracked against month dispatches"
    },
    "/diesel_tank_config/{id}": {
      "schema": "diesel_tank_config",
      "description": "Main factory diesel bowser tank fuel level and flow meter totals"
    },
    "/diesel_fuel_requests/{id}": {
      "schema": "diesel_fuel_request",
      "description": "Forklift fuel requests, HOD approvals with single-PDF unlock, and bowser meter dispensing logs"
    },
    "/diesel_grn_records/{id}": {
      "schema": "diesel_grn_record",
      "description": "Signed fuel GRN bulk deliveries into the factory bowser tank"
    },
    "/power_cut_logs/{id}": {
      "schema": "power_cut_log",
      "description": "Plant mains power cut time out, time back, and total outage duration logs"
    },
    "/generator_logs/{id}": {
      "schema": "generator_log",
      "description": "Factory generator start up and stop logs with Litre fuel levels linked to Machines"
    },
    "/sop_production_logs/{id}": {
      "schema": "sop_production_log",
      "description": "Production logger entries and WhatsApp production parser output"
    },
    "/sop_qc_checks/{id}": {
      "schema": "sop_qc_check",
      "description": "QC inspection records and WhatsApp QC parser output"
    },
    "/sop_scrap_pipeline/{id}": {
      "schema": "sop_scrap_record",
      "description": "Closed-loop scrap handover records from Operator to Recycling to Mixers"
    },
    "/sop_mixing_reports/{id}": {
      "schema": "sop_mixing_report",
      "description": "Mixing usage, sweeping, batches, WH stock balances, and HOD review records"
    },
    "/sop_shift_handovers/{id}": {
      "schema": "sop_shift_handover",
      "description": "Floor shift handover records"
    }
  }
}
