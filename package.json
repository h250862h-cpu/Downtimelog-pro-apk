{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node -e \"const fs=require('fs'),p=require('path'),d='dist/assets/aistudio';if(fs.existsSync(d)){for(const f of fs.readdirSync(d)){if(f!=='image_65f70fd7.png')fs.rmSync(p.join(d,f),{recursive:true,force:true});}}fs.rmSync('dict',{recursive:true,force:true});fs.cpSync('dist','dict',{recursive:true});\"",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "rm -rf dist dict server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "firebase": "^13.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "@grpc/grpc-js": "^1.14.7",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
